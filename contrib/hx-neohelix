#!/bin/sh
# Run the checkout build with the normal Helix config and checkout runtime.
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
binary=${HELIX_NEOHELIX_BINARY:-"$repo_root/target/release/hx"}
if [ ! -x "$binary" ]; then
    printf '%s\n' "Release Helix not found: $binary" "Build it with: nix develop --command cargo build --release --locked -p helix-term" >&2
    exit 1
fi
export HELIX_RUNTIME="$repo_root/runtime"
exec "$binary" "$@"
